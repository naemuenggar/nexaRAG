# Copy to .env and fill in real values. Never commit .env.

# One of: local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=rag
# Host-side URL (tests, alembic from your machine). Inside compose the api service
# overrides the host to "postgres".
DATABASE_URL=postgresql+asyncpg://rag:change-me-postgres-password@127.0.0.1:5432/rag
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Qdrant -------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
# Required: compose passes it to Qdrant as QDRANT__SERVICE__API_KEY. Generate like JWT_SECRET.
QDRANT_API_KEY=replace-with-a-random-qdrant-api-key

# --- Auth ---------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# --- API ----------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
# JSON list, e.g. ["http://localhost:3000"]
CORS_ALLOW_ORIGINS=[]
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# --- Ingestion ----------------------------------------------------------------
# Where uploaded PDFs are stored (relative to the working directory, or absolute).
STORAGE_DIR=data/uploads
MAX_PDF_PAGES=2000
INGESTION_POLL_INTERVAL_SECONDS=1.0
INGESTION_MAX_ATTEMPTS=3
INGESTION_LEASE_SECONDS=600

# --- Chunking & embeddings ----------------------------------------------------
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50
# false: every chunk stays on one page, so each citation names exactly one page.
CHUNK_CROSS_PAGES=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# Changing EMBEDDING_MODEL to one with another vector size requires a new collection name.
QDRANT_COLLECTION=document_chunks
# Load the embedding model at API startup (in the background) rather than on the first search.
EMBEDDING_WARM_UP=true

# --- Search -------------------------------------------------------------------
BM25_K1=1.5
BM25_B=0.75
BM25_CACHE_MAX_OWNERS=64
SEARCH_DEFAULT_TOP_K=5
SEARCH_MAX_TOP_K=50
HYBRID_CANDIDATES=30
# rrf | weighted
FUSION_METHOD=rrf
RRF_K=60
FUSION_DENSE_WEIGHT=0.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANK_CANDIDATES=20
RERANKER_WARM_UP=true
